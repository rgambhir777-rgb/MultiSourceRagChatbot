# --- Secrets & local config (never commit) ---
.env
.env.*
!.env.example

# --- Python ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# --- Model / data caches ---
.cache/
mlruns/
mlartifacts/

# --- Frontend (React / Vite) ---
node_modules/
frontend/dist/
*.local

# --- Editors & OS ---
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# --- Logs ---
*.log
npm-debug.log*

# --- Playwright (E2E) output ---
frontend/e2e-results/
