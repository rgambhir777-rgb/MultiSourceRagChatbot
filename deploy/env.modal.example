# Template for the secrets of the Modal deployment.
#
# 1. Copy this file to `.env.modal` in the PROJECT ROOT (that name is git-ignored and
#    docker-ignored, so it can never be committed or baked into an image).
# 2. Fill in the values (deploy/README.md says where each one comes from).
# 3. Upload it to Modal:   modal secret create ragbot-env --from-dotenv .env.modal --force
#
# Keep comments on their own lines: an inline "# ..." would become part of the value.

# OpenAI: the same key as in your .env
OPENAI_API_KEY=

# Qdrant Cloud: the cluster URL (ends in :6333) and an API key for it
QDRANT_URL=
QDRANT_API_KEY=

# Neon Postgres: from the connection string postgresql://USER:PASSWORD@HOST/DB
# Use the DIRECT host (without "-pooler"): the chat memory uses prepared statements,
# which Neon's pooled connections don't support.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# The site login (your browser asks for these). Password: at least 12 characters.
APP_USERNAME=ragbot
APP_PASSWORD=
