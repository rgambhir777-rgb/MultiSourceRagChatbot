# .env.example — copy to .env and adjust. .env is NEVER committed.
# Every value here is read only by the Python backend, in app/config.py (pydantic-settings).
# The React frontend needs no settings here: it calls the relative path /api,
# which the Vite dev proxy (dev) or nginx (prod) forwards to the backend.
# Never put secrets in the frontend; everything shipped to the browser is public.
# Hostnames: use 127.0.0.1 (not "localhost") when running the API on Windows (dev). "localhost" also
# resolves to IPv6 ::1, which our IPv4-only container ports do not answer, so some drivers hang first;
# docker-compose overrides them with service names (qdrant, postgres, mlflow).

# ---------- App ----------
APP_ENV=dev                         # dev | prod
LOG_LEVEL=INFO                      # DEBUG for more detail
API_HOST=127.0.0.1                  # this laptop only; docker compose uses 0.0.0.0 inside the container
API_PORT=8000
FRONTEND_PORT=8080                  # host port nginx serves the React app on (docker compose)
HEALTH_CHECK_TIMEOUT_S=5            # max seconds per dependency check in /ready

# ---------- LLM (OpenAI API: paid, billed per token) ----------
OPENAI_API_KEY=                     # REQUIRED. Use a dedicated OpenAI *project* key. Never commit, never log.
OPENAI_BASE_URL=                    # leave empty for api.openai.com (OpenAI-compatible endpoints only with approval)
LLM_GENERATOR_MODEL=gpt-6.1-sol     # writes answers ($2 / $10 per 1M tokens in/out). Budget dev mode: gpt-6-luna
LLM_GENERATOR_REASONING_EFFORT=low  # low | medium | high ... (higher = slower + more expensive)
LLM_JUDGE_MODEL=gpt-6-luna          # route / grade / grounding ($0.10 / $0.50 per 1M tokens)
LLM_JUDGE_REASONING_EFFORT=none     # none = fastest and cheapest
LLM_MAX_OUTPUT_TOKENS=1024          # hard cap per call (cost control)
PROMPT_MAX_TOKENS=8000              # our own cap on prompt size (history + chunks), counted with tiktoken
LLM_REQUEST_TIMEOUT_S=60
LLM_MAX_RETRIES=2                   # retries on 429 / 5xx with exponential backoff
# Prices used only for the cost estimates in logs and traces (USD per 1M tokens). Update if OpenAI changes them.
LLM_GENERATOR_PRICE_IN=2.00
LLM_GENERATOR_PRICE_OUT=10.00
LLM_JUDGE_PRICE_IN=0.10
LLM_JUDGE_PRICE_OUT=0.50

# ---------- Embeddings & reranking (FastEmbed, CPU) ----------
EMBED_DENSE_MODEL=BAAI/bge-small-en-v1.5
EMBED_SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
FASTEMBED_CACHE_DIR=./.cache/fastembed  # models download here once (git-ignored)
EMBED_BATCH_SIZE=32                 # chunks embedded per model call (more = faster, more RAM)

# ---------- Retrieval ----------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=                     # empty for local; set in prod
QDRANT_COLLECTION=knowledge_base
QDRANT_TIMEOUT_S=30                 # seconds per Qdrant request
RETRIEVE_CANDIDATES=20              # hybrid search results before reranking
RERANK_TOP_K=5                      # chunks given to the LLM

# ---------- Chunking ----------
CHUNK_SIZE_TOKENS=400                # stays under the 512-token limit of the bge-small embedding model
CHUNK_OVERLAP_TOKENS=75             # must be smaller than CHUNK_SIZE_TOKENS
TOKENIZER_ENCODING=o200k_base       # tiktoken encoding used to count tokens
MIN_CHARS_PER_PDF_PAGE=20           # fewer extracted chars per page => probably a scanned PDF

# ---------- Agent loop guards ----------
MAX_QUERY_REWRITES=2
MAX_REGENERATIONS=1
HISTORY_MAX_TURNS=10                # past turns kept in the prompt

# ---------- PostgreSQL (app tables + LangGraph memory) ----------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ragbot
POSTGRES_USER=ragbot
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_POOL_MAX_SIZE=5            # max open connections the app keeps for reuse
POSTGRES_CONNECT_TIMEOUT_S=5

# ---------- Ingestion limits ----------
MAX_UPLOAD_MB=25
ALLOWED_FILE_TYPES=.pdf,.md,.txt,.docx
GITHUB_MAX_FILES=2000
GITHUB_MAX_FILE_KB=500
GITHUB_CLONE_TIMEOUT_S=120
GITHUB_TOKEN=                       # optional: only for private repos / higher rate limits

# ---------- Observability (MLflow) ----------
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=agentic-rag
TRACING_ENABLED=true

# ---------- Stretch: evaluation ----------
DEEPEVAL_TELEMETRY_OPT_OUT=YES      # keep DeepEval fully local

# ---------- Stretch: n8n (only if the licence is accepted) ----------
N8N_ENCRYPTION_KEY=change-me
INTERNAL_API_KEY=change-me          # n8n -> API webhook auth
