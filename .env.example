# .env.example — copy to .env and adjust. .env is NEVER committed.
# Every value here is read only by the Python backend, in app/config.py (pydantic-settings).
# The React frontend needs no settings here: it calls the relative path /api,
# which the Vite dev proxy (dev) or nginx (prod) forwards to the backend.
# Never put secrets in the frontend; everything shipped to the browser is public.
# Hostnames: use "localhost" when running the API on Windows (dev);
# docker-compose overrides them with service names (qdrant, postgres, ollama, mlflow).

# ---------- App ----------
APP_ENV=dev                         # dev | prod
LOG_LEVEL=INFO                      # DEBUG for more detail
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=8080                  # host port nginx serves the React app on (docker compose)

# ---------- LLM (Ollama) ----------
OLLAMA_BASE_URL=http://localhost:11434
LLM_GENERATOR_MODEL=qwen3.5:4b      # writes answers
LLM_JUDGE_MODEL=qwen3.5:2b          # route / grade / grounding (fast)
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=8192                    # context window in tokens; bigger = slower + more RAM
LLM_REQUEST_TIMEOUT_S=180
OLLAMA_THINK=false                  # disable "thinking" for speed on CPU
OLLAMA_KEEP_ALIVE=30m               # keep models loaded between requests

# ---------- Embeddings & reranking (FastEmbed, CPU) ----------
EMBED_DENSE_MODEL=BAAI/bge-small-en-v1.5
EMBED_SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
FASTEMBED_CACHE_DIR=./.cache/fastembed

# ---------- Retrieval ----------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                     # empty for local; set in prod
QDRANT_COLLECTION=knowledge_base
RETRIEVE_CANDIDATES=20              # hybrid search results before reranking
RERANK_TOP_K=5                      # chunks given to the LLM

# ---------- Chunking ----------
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75

# ---------- Agent loop guards ----------
MAX_QUERY_REWRITES=2
MAX_REGENERATIONS=1
HISTORY_MAX_TURNS=10                # past turns kept in the prompt

# ---------- PostgreSQL (app tables + LangGraph memory) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragbot
POSTGRES_USER=ragbot
POSTGRES_PASSWORD=change-me-local-only

# ---------- Ingestion limits ----------
MAX_UPLOAD_MB=25
ALLOWED_FILE_TYPES=.pdf,.md,.txt,.docx
GITHUB_MAX_FILES=2000
GITHUB_MAX_FILE_KB=500
GITHUB_CLONE_TIMEOUT_S=120
GITHUB_TOKEN=                       # optional: only for private repos / higher rate limits

# ---------- Observability (MLflow) ----------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=agentic-rag
TRACING_ENABLED=true

# ---------- Stretch: evaluation ----------
DEEPEVAL_TELEMETRY_OPT_OUT=YES      # keep DeepEval fully local

# ---------- Stretch: n8n (only if the licence is accepted) ----------
N8N_ENCRYPTION_KEY=change-me
INTERNAL_API_KEY=change-me          # n8n -> API webhook auth
